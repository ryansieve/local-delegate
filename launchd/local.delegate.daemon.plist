<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: bin/setup-delegate fills __PROJECT_DIR__ and __HOME__ and installs it to ~/Library/LaunchAgents. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>local.delegate.daemon</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/bin/start-daemon</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>__HOME__/delegate/daemon.log</string>
  <key>StandardErrorPath</key><string>__HOME__/delegate/daemon.log</string>
</dict>
</plist>
