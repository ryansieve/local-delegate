# Project-root .env on the delegate machine (gitignored, chmod 600).
# bin/bootstrap and bin/setup-delegate create and fill this; everything below has a working default.

# Generated by setup-delegate (openssl rand -hex 32). The laptop fetches it over SSH.
DELEGATE_TOKEN=

# Keep 127.0.0.1: the laptop reaches the daemon through an SSH tunnel, so nothing needs to listen on the network.
DELEGATE_HOST=127.0.0.1
DELEGATE_PORT=7420
# DELEGATE_HOME=~/delegate

# OpenAI-compatible endpoint with tool calling (default: Ollama). MODEL_NAME must match an id from $MODEL_BASE_URL/models.
MODEL_BASE_URL=http://127.0.0.1:11434/v1
MODEL_NAME=laguna-s-2.1:nvfp4
# Must match OLLAMA_CONTEXT_LENGTH; drives the context guard.
MODEL_CONTEXT_TOKENS=131072
# MODEL_MAX_TOKENS=32768
# MODEL_TEMPERATURE=
# MODEL_REQUEST_TIMEOUT_MS=3600000

# Default per-task budget (Claude can override per task).
# AGENT_MAX_TURNS=25
# AGENT_MAX_MINUTES=15
# AGENT_MAX_VERIFY_ATTEMPTS=4
# Stall detection: nudge after N turns without file changes; stop after this many nudges.
# AGENT_STALL_TURNS=10
# AGENT_MAX_NUDGES=2
# Context guard: warn / stop at this fraction of MODEL_CONTEXT_TOKENS.
# AGENT_CONTEXT_WARN=0.6
# AGENT_CONTEXT_STOP=0.85
# AGENT_COMMAND_TIMEOUT_MS=600000
# AGENT_TOOL_OUTPUT_CHARS=6000
# AGENT_VERIFY_OUTPUT_CHARS=8000
# AGENT_READ_FILE_LINES=200

# Rust repos: share a build cache across rounds so each worktree doesn't rebuild from scratch.
# CARGO_TARGET_DIR=/Users/you/delegate/cargo-target

# Pinned by setup-delegate so launchd sees the same node/pnpm/cargo as your shell.
# NODE_BIN=
# DELEGATE_PATH=
